# RLM Studio Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# LLM Provider API Keys
# ============================================================
# RLM Studio will auto-detect the first available provider.
# Uncomment and set the one(s) you want to use.

# OpenAI (https://platform.openai.com/api-keys)
# Supports: GPT-4, GPT-4 Turbo, GPT-3.5
OPENAI_API_KEY=sk-your-key-here

# Anthropic Claude (https://console.anthropic.com/)
# Supports: Claude Sonnet / Opus / Haiku (4.x series)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama (Local LLM server)
# Default: http://localhost:11434
# Supports: Llama3, Mistral, Phi, and more
# Uncomment to override default:
# OLLAMA_BASE_URL=http://localhost:11434

# LM Studio (Local LLM server)
# Default port: 1234
# LMSTUDIO_BASE_URL=http://localhost:1234

# vLLM (High-performance inference server)
# VLLM_BASE_URL=http://localhost:8000

# ============================================================
# Optional: Default Model Selection
# ============================================================
# Override the default model for each provider

# RLM_STUDIO_OPENAI_DEFAULT_MODEL=gpt-4o-mini
# RLM_STUDIO_ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
# RLM_STUDIO_OLLAMA_DEFAULT_MODEL=llama3.2

# ============================================================
# Optional: Execution Configuration
# ============================================================

# ============================================================
# Server bind (used by `rlm-studio studio`, `python -m rlmstudio.server`
# and the Docker Compose stack). In compose, RLM_STUDIO_PORT drives the
# published port, the container bind, and the frontend's backend URLs.
# ============================================================

# RLM_STUDIO_HOST=127.0.0.1
# RLM_STUDIO_PORT=8000

# Maximum execution steps for RLM mode
# RLM_STUDIO_MAX_STEPS=50

# Timeout for code execution (seconds)
# RLM_STUDIO_TIMEOUT=30

# Enable verbose logging
# RLM_STUDIO_VERBOSE=false

# ============================================================
# Usage Examples
# ============================================================
#
# 1. Auto-detection (uses first available provider):
#    from rlmstudio import interact
#    result = interact("content", "query")
#
# 2. Explicit provider:
#    result = interact("content", "query", provider="openai")
#
# 3. Check available providers:
#    from rlmstudio.llm import list_available_providers
#    print(list_available_providers())
#
# 4. Get provider info:
#    from rlmstudio.llm import get_provider_info
#    print(get_provider_info())
