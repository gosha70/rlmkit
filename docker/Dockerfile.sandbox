FROM python:3.11-slim

# Security: run as non-root user with no shell
RUN useradd --no-create-home --shell /bin/false sandbox

# Sandbox working directory owned by sandbox user
RUN mkdir -p /sandbox && chown sandbox:sandbox /sandbox

WORKDIR /sandbox

USER sandbox

# No extra packages — RLM exploration uses Python stdlib only (re, json, math, etc.)
# Scripts are mounted read-only at /sandbox/script.py by DockerExecutor
