# syntax=docker/dockerfile:1.7

# RLMKit frontend — Next.js 16 production image.
#
# Stage 1 installs deps, stage 2 builds, stage 3 ships the runtime.
# The Next.js app proxies `/api`, `/health`, and `/ws` to the backend
# pointed to by NEXT_PUBLIC_API_URL (see frontend/next.config.ts).
# Default: http://localhost:8000 — override in docker-compose for
# cross-container traffic (e.g. http://backend:8000).
#
# Build:
#   docker build -f docker/Dockerfile.frontend -t rlmkit-frontend .
#
# Run:
#   docker run --rm -p 3000:3000 \
#     -e NEXT_PUBLIC_API_URL=http://localhost:8000 \
#     rlmkit-frontend

# ---------------------------------------------------------------------------
# Stage 1: deps — install node_modules from lockfile (cached independently)
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS deps

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

# ---------------------------------------------------------------------------
# Stage 2: builder — compile the Next.js app for production
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./

# NEXT_PUBLIC_* env vars are baked into the client bundle at build time.
# Override here (via --build-arg) only if you need a non-default API URL in
# the bundle itself; the docker-compose stack uses the default proxy path
# and does not require customization.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ARG NEXT_PUBLIC_RLMKIT_PERF_UI
ENV NEXT_PUBLIC_RLMKIT_PERF_UI=${NEXT_PUBLIC_RLMKIT_PERF_UI}

RUN npm run build

# ---------------------------------------------------------------------------
# Stage 3: runtime — ship only what `next start` needs
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app

RUN useradd --create-home --shell /bin/bash --uid 1001 nextjs

# Copy the production-ready artifacts + just enough node_modules for `next start`.
COPY --from=builder --chown=nextjs:nextjs /app/.next ./.next
COPY --from=builder --chown=nextjs:nextjs /app/public ./public
COPY --from=builder --chown=nextjs:nextjs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nextjs /app/package-lock.json ./package-lock.json
COPY --from=builder --chown=nextjs:nextjs /app/next.config.ts ./next.config.ts
COPY --from=builder --chown=nextjs:nextjs /app/node_modules ./node_modules

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "require('http').get('http://127.0.0.1:' + (process.env.PORT||3000), r => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["npm", "run", "start"]
